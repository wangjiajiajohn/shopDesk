# ============================================================
# ShopDesk TikTok Shop 授权配置
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会进版本库
# ============================================================

# Partner Center → App & Service → 你的应用详情页
TIKTOK_APP_KEY=请填入_app_key
TIKTOK_APP_SECRET=请填入_app_secret
TIKTOK_SERVICE_ID=请填入_service_id

# 接口域名：墨西哥等 ROW 站点用 tiktokglobalshop；美区后续切换为 us.tiktokshop
TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com
# Token 换发/刷新域名（全球统一）
TIKTOK_AUTH_BASE=https://auth.tiktok-shops.com

# 完整 OAuth 跳转回调（第一版手动 token 用不到，产品化时启用）
TIKTOK_REDIRECT_URL=http://localhost:8088/api/tiktok/auth/callback

# Token 加密密钥文件（留空则使用 backend/.token_key，自动生成）
SHOPDESK_TOKEN_KEY_PATH=

# ============================================================
# OpenAI 兼容大模型（OpenAI 官方 / APIMart 等网关通用）
# 切换 APIMart：BASE_URL 改为 https://api.apimart.ai/v1，API_KEY 换为 apimart key
# ============================================================
OPENAI_API_KEY=请填入_openai_或_apimart_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-min
